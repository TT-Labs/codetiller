# Working-dir secrets, read by `tiller` from .env (mode 600). The real environment wins.

# Model API key. Given only to the model gateway, never to an agent container.
# Use a dedicated key with a spend limit.
ANTHROPIC_API_KEY=

# GitHub: import issues, push task branches, open draft pull requests, read CI.
# Fine-grained personal access token limited to the repositories the factory works on:
# Contents read and write, Pull requests read and write, Issues read; to follow the
# repository's CI also Checks read, Commit statuses read, Actions read.
TILLER_GITHUB_TOKEN=

# Optional.
# TILLER_EGRESS=direct        # no registry proxy: dependency installs on the open network
# TILLER_BASE_IMAGE=          # sandbox base image in place of codetiller/base:dev
# TILLER_DEBUG=1              # print the output of test commands during verification
